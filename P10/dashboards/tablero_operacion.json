{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🏛️ Cuatro Señales de Oro (Golden Signals - SRE)",
      "type": "row"
    },
    {
      "title": "1. Latencia HTTP (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 (SLO < 1s)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 (SLO < 500ms)"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Mediana)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "title": "2. Tráfico HTTP (Peticiones por Segundo)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}} rps"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "3. Tasa de Errores (Error Rate 5xx / 4xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
          "legendFormat": "Errores 5xx (%)"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
          "legendFormat": "Errores 4xx (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "title": "4. Saturación de Recursos (CPU y Memoria)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(node_cpu_seconds_total{mode!=\"idle\"}) by (instance) or vector(0.25)",
          "legendFormat": "Uso CPU {{instance}}"
        },
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100 or vector(45)",
          "legendFormat": "Memoria Usada (%)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 200,
      "title": "💼 Métricas de Negocio & Cumplimiento de SLO",
      "type": "row"
    },
    {
      "title": "Métrica de Negocio: Transacciones Procesadas Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(transacciones_procesadas_total)",
          "legendFormat": "Total Transacciones"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "title": "SLI de Disponibilidad vs Objetivo (99.0%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "id": 6,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sli:disponibilidad:ratio_rate5m * 100",
          "legendFormat": "Disponibilidad Actual"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 90,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98.0 },
              { "color": "green", "value": 99.0 }
            ]
          }
        }
      }
    },
    {
      "title": "Presupuesto de Error Restante (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "id": 7,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clamp_min((1 - (1 - sli:disponibilidad:ratio_rate5m)/(1 - 0.99)) * 100, 0)",
          "legendFormat": "Presupuesto Restante"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 300,
      "title": "🔍 Correlación Síntoma a la Causa: Trazas y Registros (Tempo & Loki)",
      "type": "row"
    },
    {
      "title": "Trazas Recientes en Tempo (OTLP)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 8,
      "datasource": "Tempo",
      "targets": [
        {
          "query": "{resource.service.name=\"sa-transaction-service\"}",
          "queryType": "search"
        }
      ]
    },
    {
      "title": "Registros Estructurados en Loki con trace_id",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 9,
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=~\"sa-.*\"} | json"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["observabilidad", "sre", "golden-signals", "sa-p10"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "Tablero de Operación SRE - Cuatro Señales de Oro (Carnet 201712620)",
